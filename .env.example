# LangGraph Multi-Agent Analyzer - Environment Configuration
# Copy this file to .env and configure as needed

# Ollama Configuration
# Make sure Ollama is running on localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM Configuration
# Temperature settings for different agents (0.0 = deterministic, 1.0 = creative)
CLAIMS_TEMPERATURE=0.3
METHODOLOGY_TEMPERATURE=0.4
LIMITATIONS_TEMPERATURE=0.5
SYNTHESIZER_TEMPERATURE=0.6

# Output Configuration
OUTPUT_DIR=outputs
MAX_PDF_PAGES=50# Maximum pages to process from PDF

# LangGraph Configuration
CHECKPOINT_DIR=.checkpoints# Where to store workflow checkpoints (if using file-based)

# Optional: LangSmith Tracing (for debugging and monitoring)
# Sign up at https://smith.langchain.com/ for free tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_api_key_here
# LANGCHAIN_PROJECT=langgraph-paper-analyzer

# Debug Configuration
DEBUG=false
VERBOSE=false